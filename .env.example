NODE_ENV=development
PORT=3000

# Required: the service refuses to start without it. Same value as PEC_API_KEY in the backend
API_KEY=

# IBGE code of the city this instance serves
IBGE_CODE=

DATABASE_CITY_HALL="postgresql://user:password@localhost:5432/city_hall?schema=public"
DATABASE_SOURCE_URL="postgresql://user:password@localhost:5432/esus?schema=public"
DATABASE_JUNTOS_URL="postgresql://user:password@localhost:5432/juntos?schema=public"

ENABLE_CRON=false
CRON_EXPRESSION="0 3 * * *"

# Comma-separated list of allowed origins; empty accepts any origin
CORS_ORIGINS=
# Swagger at /api; defaults to on only when NODE_ENV=development
SWAGGER_ENABLED=
