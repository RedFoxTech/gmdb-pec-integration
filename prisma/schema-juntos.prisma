// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  // binaryTargets   = ["native", "darwin", "debian-openssl-1.1.x", "linux-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["relationJoins"]
  output = "./generated/juntos"
}

datasource dbJuntos {
  provider = "postgresql"
  url      = env("DATABASE_JUNTOS_URL")
}

model Pni {
  nuCns                         String?      @map("nu_cns") @dbJuntos.VarChar(30)    
  dtNascimento                  DateTime    @map("dt_nascimento") @dbJuntos.Date       
  noImunobiologico              String?      @map("no_imunobiologico") @dbJuntos.VarChar(150)
  dtAplicacao                   DateTime?    @map("dt_aplicacao") @dbJuntos.Date
  noCidadao                     String      @map("no_cidadao") @dbJuntos.VarChar(100)    

  @@id([noCidadao, dtNascimento])
  @@map("vacinacao_psni")
}
