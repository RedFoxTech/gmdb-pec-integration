          WHEN GREATEST(ap.dt_solicitado, ap.dt_coleta, ap.dt_avaliado) = ap.dt_coleta THEN 'dt_coleta'
          WHEN GREATEST(ap.dt_solicitado, ap.dt_coleta, ap.dt_avaliado) = ap.dt_solicitado THEN 'dt_solicitado'
          ELSE NULL
        END AS "dtUtilizada",
