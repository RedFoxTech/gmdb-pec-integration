exports[`SQL generated for valid filters exam/direct queryAll acs#0 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  
       WHERE (p.id_profissional IS NOT null AND p.id_profissional IN (101)
      ))
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  "
`;

exports[`SQL generated for valid filters exam/direct queryAll acs#1 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  
       WHERE (p.id_profissional IS NOT null AND p.id_profissional IN (101,202)
      ))
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  "
`;

exports[`SQL generated for valid filters exam/direct queryAll acs#2 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  
       WHERE (p.id_profissional IS null
      ))
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  "
`;

exports[`SQL generated for valid filters exam/direct queryAll acs#3 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  
       WHERE (p.id_profissional IS NOT null AND p.id_profissional IN (101)
      
       OR p.id_profissional IS null
      ))
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  "
`;

exports[`SQL generated for valid filters exam/direct queryAll all 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= '2010-01-01'::DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= '2010-01-01'::DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= '2010-01-01'::DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN '2010-01-01'::DATE - INTERVAL '3 years' AND '2010-01-01'::DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN '2010-01-01'::DATE - INTERVAL '3 years' AND '2010-01-01'::DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN '2010-01-01'::DATE - INTERVAL '3 years' AND '2010-01-01'::DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > '2010-01-01'::DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  '2010-01-01'::DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  
     WHERE lower(p.no_cidadao) ILIKE lower('%Maria%')
    
       AND (p.id_profissional IS NOT null AND p.id_profissional IN (101)
      )
       AND (p.nu_cnes IS NOT null AND p.nu_cnes IN ('2526565')
      ) AND p.dt_nascimento BETWEEN '2010-01-01' AND '2010-01-01')
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  
    WHERE ex.status IN (2)
    
     AND ex."scheduleStatus" IN (2)
    "
`;

exports[`SQL generated for valid filters exam/direct queryAll base 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  )
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  "
`;

exports[`SQL generated for valid filters exam/direct queryAll collectionYear#0 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  )
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  "
`;

exports[`SQL generated for valid filters exam/direct queryAll examAppointmentStatus#0 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  )
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  
    WHERE ex."scheduleStatus" IN (2)
    "
`;

exports[`SQL generated for valid filters exam/direct queryAll examAppointmentStatus#1 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  )
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  
    WHERE ex."scheduleStatus" IN (0,1,2)
    "
`;

exports[`SQL generated for valid filters exam/direct queryAll examDateTo#0 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= '2010-01-01'::DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= '2010-01-01'::DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= '2010-01-01'::DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN '2010-01-01'::DATE - INTERVAL '3 years' AND '2010-01-01'::DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN '2010-01-01'::DATE - INTERVAL '3 years' AND '2010-01-01'::DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN '2010-01-01'::DATE - INTERVAL '3 years' AND '2010-01-01'::DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > '2010-01-01'::DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  '2010-01-01'::DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  )
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  "
`;

exports[`SQL generated for valid filters exam/direct queryAll examDateTo#1 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= '2010-01-01T03:00:00.000Z'::DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= '2010-01-01T03:00:00.000Z'::DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= '2010-01-01T03:00:00.000Z'::DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN '2010-01-01T03:00:00.000Z'::DATE - INTERVAL '3 years' AND '2010-01-01T03:00:00.000Z'::DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN '2010-01-01T03:00:00.000Z'::DATE - INTERVAL '3 years' AND '2010-01-01T03:00:00.000Z'::DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN '2010-01-01T03:00:00.000Z'::DATE - INTERVAL '3 years' AND '2010-01-01T03:00:00.000Z'::DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > '2010-01-01T03:00:00.000Z'::DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  '2010-01-01T03:00:00.000Z'::DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  )
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  "
`;

exports[`SQL generated for valid filters exam/direct queryAll examStatus#0 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  )
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  
    WHERE ex.status IN (2)
    "
`;

exports[`SQL generated for valid filters exam/direct queryAll examStatus#1 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  )
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  
    WHERE ex.status IN (2,1,0,-1)
    "
`;

exports[`SQL generated for valid filters exam/direct queryAll examStatus#2 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  )
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  
    WHERE ex.status IN (-1)
    "
`;

exports[`SQL generated for valid filters exam/direct queryAll gender#0 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  )
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  "
`;

exports[`SQL generated for valid filters exam/direct queryAll gender#1 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  )
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  "
`;

exports[`SQL generated for valid filters exam/direct queryAll patientBeginAgeDate#0 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
   WHERE p.dt_nascimento >= '2010-01-01')
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  "
`;

exports[`SQL generated for valid filters exam/direct queryAll patientBeginAgeDate#1 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
   WHERE p.dt_nascimento >= '2010-01-01T03:00:00.000Z')
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  "
`;

exports[`SQL generated for valid filters exam/direct queryAll patientEndAgeDate#0 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
   WHERE p.dt_nascimento <= '2010-01-01')
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  "
`;

exports[`SQL generated for valid filters exam/direct queryAll patientEndAgeDate#1 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
   WHERE p.dt_nascimento <= '2010-01-01T03:00:00.000Z')
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  "
`;

exports[`SQL generated for valid filters exam/direct queryAll patientName#0 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  
     WHERE lower(p.no_cidadao) ILIKE lower('%Maria%')
    )
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  "
`;

exports[`SQL generated for valid filters exam/direct queryAll patientName#1 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  
     WHERE lower(p.no_cidadao) ILIKE lower('%José da Silva%')
    )
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  "
`;

exports[`SQL generated for valid filters exam/direct queryAll units#0 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  
       WHERE (p.nu_cnes IS NOT null AND p.nu_cnes IN ('2526565')
      ))
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  "
`;

exports[`SQL generated for valid filters exam/direct queryAll units#1 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  
       WHERE (p.nu_cnes IS NOT null AND p.nu_cnes IN ('2526565','2481286')
      ))
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  "
`;

exports[`SQL generated for valid filters exam/direct queryAll units#2 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  
       WHERE (p.nu_cnes IS null
      ))
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  "
`;

exports[`SQL generated for valid filters exam/direct queryAll units#3 1`] = `
"
    WITH exams as (
      SELECT distinct on(ap.id_paciente)
        ap.id_paciente as "patientPecId",
        ap.dt_coleta as "colectDate",
        ap.dt_solicitado as "solicitationDate",
        ap.agendado::boolean as scheduled,
        ap.dt_avaliado as "evaluatedDate",
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
          ELSE 0 -- Vencido
        END AS status,
        CASE
          WHEN ap.dt_coleta >= CURRENT_DATE - INTERVAL '1 year' THEN 2 -- Não aplicável
          WHEN ap.agendado = 1 THEN 1 -- Agendado
          ELSE 0 -- Pendente
        END AS "scheduleStatus",
        json_build_object(
          'patientPecId', p.id_paciente,
          'name', p.no_cidadao,
          'document', p.cpf,
          'birthdate', p.dt_nascimento,
          'cns', p.cns,
          'gender', CASE
            WHEN p.sexo = 'F' THEN 'Feminino'
            ELSE 'Masculino'
          END,
          'address', p.logradouro,
          'neighborhood', p.bairro,
          'phone', p.contato,
          'email', null::text,
          'responsibleName', p.no_mae,
          'responsibleDocument', null::text,
          'acs', CASE
            WHEN p.id_profissional IS NOT NULL THEN json_build_object(
              'id', p.id_profissional::int,
              'name', p.no_prof_cad
            )
            ELSE NULL
          END,
          'unit', CASE
            WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
              'id', un.nu_cnes,
              'name', un.no_unidade,
              'address', un.logradouro,
              'addressNumber', un.nu_logradouro,
              'neighborhood', un.bairro,
              'zipcode', un.cep
            )
            ELSE NULL
          END
        ) as patient
      FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ap
      INNER JOIN (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p on p.id_paciente = ap.id_paciente
      LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  
       WHERE (p.nu_cnes IS NOT null AND p.nu_cnes IN ('2526565')
      
       OR p.nu_cnes IS null
      ))
  SELECT
    ex.*,
    CASE
      WHEN sc.data_agenda IS NULL THEN NULL
      ELSE (sc.data_agenda + sc.hr_agendado::time)::timestamp
    END AS "agendaAt"
  FROM exams ex
  LEFT JOIN  (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc on sc.id_paciente = ex."patientPecId" AND sc.dt_criacao = ex."colectDate"
  "
`;

exports[`SQL generated for valid filters exam/direct queryExamAppointments id 1`] = `
"
  WITH exams as (
    SELECT * FROM (
WITH citopatologico_coletado AS (
    SELECT 
        coletado.co_fat_cidadao_pec,
        coletado.co_dim_profissional,
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_coleta  
    FROM 
        public.tb_fat_proced_atend coletado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = coletado.co_dim_cbo 
    WHERE 
        coletado.ds_filtro_procedimento ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND coletado.co_fat_cidadao_pec is not null
    GROUP BY 
        coletado.co_fat_cidadao_pec, coletado.co_dim_profissional
    HAVING 
        MAX(TO_DATE(coletado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_solicitado AS (
    SELECT 
        solicitado.co_fat_cidadao_pec,
        solicitado.co_dim_profissional_1,
        solicitado.st_conduta_consulta_agendada,
        solicitado.st_conduta_cuidd_conti_program,
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_solicitado 
    FROM 
        public.tb_fat_atendimento_individual solicitado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = solicitado.co_dim_cbo_1        
    WHERE         
        solicitado.ds_filtro_proced_solicitados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND solicitado.co_fat_cidadao_pec is not null
    GROUP BY 
        solicitado.co_fat_cidadao_pec, solicitado.co_dim_profissional_1, solicitado.st_conduta_consulta_agendada, solicitado.st_conduta_cuidd_conti_program
    HAVING 
        MAX(TO_DATE(solicitado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
),
citopatologico_avaliado AS (
    SELECT 
        avaliado.co_fat_cidadao_pec,
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) AS dt_avaliado  
    FROM 
        public.tb_fat_atendimento_individual avaliado
    LEFT JOIN tb_dim_cbo ON tb_dim_cbo.co_seq_dim_cbo = avaliado.co_dim_cbo_1        
    WHERE 
        avaliado.ds_filtro_proced_avaliados ILIKE ANY (ARRAY['%0201020033%', '%0203010086%', '%0203010019%', '%0201020076%', '%0201020084%', '%ABPG010%'])
        AND avaliado.co_fat_cidadao_pec is not null
    GROUP BY 
        avaliado.co_fat_cidadao_pec
    HAVING 
        MAX(TO_DATE(avaliado.co_dim_tempo::text, 'YYYYMMDD')) BETWEEN CURRENT_DATE - INTERVAL '3 years' AND CURRENT_DATE
)
select
    distinct on(tb_cidadao.co_seq_cidadao)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente,     
	citopatologico_coletado.co_dim_profissional as id_profissional_coleta,
    citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
    citopatologico_solicitado.co_dim_profissional_1 as id_profissional_solicitacao, -- profissional da consulta
	citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
	CASE
	    WHEN citopatologico_solicitado.st_conduta_consulta_agendada = 1 or citopatologico_solicitado.st_conduta_cuidd_conti_program = 1 THEN 1
	    ELSE 0
	END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado 
	citopatologico_avaliado.dt_avaliado
FROM tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec ON tb_fat_cidadao_pec.co_cidadao = tb_cidadao.co_seq_cidadao
	LEFT JOIN tb_cds_cad_individual ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
	LEFT JOIN citopatologico_coletado ON citopatologico_coletado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
	LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.co_fat_cidadao_pec = tb_fat_cidadao_pec.co_seq_fat_cidadao_pec
WHERE
    tb_cidadao.st_ativo = 1
    AND tb_cidadao.st_ativo_para_exibicao = 1
    AND tb_cidadao.dt_nascimento > CURRENT_DATE - INTERVAL '64 years' -- filtra idade relacionada ao exame
	AND tb_cidadao.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years' 
	AND tb_cds_cad_individual.co_sexo = 1 -- busca apenas sexo feminino
    AND tb_cidadao.st_faleceu = 0 -- exclui os falecidos
) ex
    WHERE ex.id_paciente = 12345 AND ex.dt_avaliado IS NOT null
  )
  SELECT
    sc.id_agendamento as id,
    sc.id_paciente as "patientPecId",
    (sc.dt_criacao + sc.hr_cricao::time)::timestamp as "createdAt",
    (sc.data_agenda + sc.hr_agendado::time)::timestamp as "agendaAt"
  FROM (
select
tb_agendado.co_seq_agendado as id_agendamento,
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec as id_paciente, -- identificador do paciente relacionado a query pacientes
tb_agendado.dt_criacao::date as dt_criacao, -- data que foi criada a agenda
tb_agendado.dt_criacao::time as hr_criacao, -- hora que foi criada a agenda
tb_agendado.hr_inicial_agendado::date as data_agenda, -- data para qual dia foi agendado
tb_agendado.hr_inicial_agendado::time as hr_agendado -- hora para qual foi agendado
FROM tb_agendado
left join tb_prontuario on tb_agendado.co_prontuario = tb_prontuario.co_seq_prontuario
left join tb_fat_cidadao_pec on tb_prontuario.co_cidadao = tb_fat_cidadao_pec.co_cidadao
where 
tb_fat_cidadao_pec.co_seq_fat_cidadao_pec is not null
and tb_agendado.dt_criacao is not null
order by
tb_agendado.co_seq_agendado
) sc
  INNER JOIN exams ex on ex.id_paciente = sc.id_paciente
  WHERE ex.dt_coleta = sc.dt_criacao
  "
`;

exports[`SQL generated for valid filters exam/index buildExamsQuery date#0 1`] = `
"
    WITH citopatologico_coletado AS (
      SELECT * FROM collected
      WHERE city_hall_id = 2303709
      GROUP BY
        id_atend_coleta, import_version_id, city_hall_id
      
      HAVING
          dt_coleta BETWEEN '2010-01-01'::DATE - INTERVAL '3 years' AND '2010-01-01'::DATE
      
    ),
    citopatologico_solicitado AS (
      SELECT * FROM requested
      WHERE city_hall_id = 2303709
      GROUP BY
        id_atend_solicitacao, import_version_id, city_hall_id
        
        HAVING
            dt_solicitado BETWEEN '2010-01-01'::DATE - INTERVAL '3 years' AND '2010-01-01'::DATE
        
    ),
    citopatologico_avaliado AS (
      SELECT * FROM evaluated
      WHERE city_hall_id = 2303709
      GROUP BY
        id_atend_avaliado, import_version_id, city_hall_id
        
        HAVING
            dt_avaliado BETWEEN '2010-01-01'::DATE - INTERVAL '3 years' AND '2010-01-01'::DATE
        
    )
    select
      pt.id_paciente,
      citopatologico_coletado.id_prof_coleta as id_profissional_coleta,
      citopatologico_coletado.dt_coleta, -- data que foi coletado material para exaame
      citopatologico_solicitado.id_prof_solicitacao as id_profissional_solicitacao, -- profissional da consulta
      citopatologico_solicitado.dt_solicitado, -- caso tenha sido solicitado e não coletado na unidade terá a data da solicitação
      CASE
          WHEN citopatologico_solicitado.st_consulta_agendada = 1 or citopatologico_solicitado.st_cuidado_continuo = 1 THEN 1
          ELSE 0
      END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado
      citopatologico_avaliado.dt_avaliado,
      citopatologico_coletado.filtro_procedimento as filtro_procedimento_coleteado,
      citopatologico_solicitado.filtro_procedimento as filtro_procedimento_solicitado,
      citopatologico_avaliado.filtro_procedimento as filtro_procedimento_avaliado
    FROM patients pt
      LEFT JOIN citopatologico_coletado ON citopatologico_coletado.id_paciente = pt.id_paciente
      LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.id_paciente = pt.id_paciente
      LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.id_paciente = pt.id_paciente
    WHERE pt.city_hall_id = 2303709
      AND pt.dt_nascimento > '2010-01-01'::DATE - INTERVAL '65 years' -- filtra idade relacionada ao exame
      AND pt.dt_nascimento <=  '2010-01-01'::DATE - INTERVAL '25 years'
      AND pt.sexo = 'F' -- busca apenas sexo feminino
"
`;

