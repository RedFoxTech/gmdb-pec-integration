    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un
      LEFT JOIN (
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (SELECT * FROM patients WHERE city_hall_id = 2303709) p
    LEFT JOIN (SELECT * FROM unit WHERE city_hall_id = 2303709) un ON un.nu_cnes = p.nu_cnes WHERE p.dt_nascimento >= '2010-01-01'),
  vaccinations AS (SELECT * FROM vaccination vc
    WHERE vc.city_hall_id = 2303709),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  ) pt on (pt.unit->>'id') = un.nu_cnes
      GROUP BY un.nu_cnes, un.no_unidade, un.logradouro, un.nu_logradouro, un.bairro, un.cep
    ),
    rankedUnits as (
      SELECT
        uv.*,
        DENSE_RANK() OVER (ORDER BY uv.vaccinated DESC)::int AS position
      FROM unitsWithVaccination uv
    )
    SELECT * FROM rankedUnits ru
  
    ORDER BY ru.vaccinated DESC
  "
`;

