          WHEN citopatologico_solicitado.st_consulta_agendada = 1 or citopatologico_solicitado.st_cuidado_continuo = 1 THEN 1
          ELSE 0
      END AS agendado, -- informa que teve um agendamento ou se foi um cuidado continuado
      citopatologico_avaliado.dt_avaliado,
      citopatologico_coletado.filtro_procedimento as filtro_procedimento_coleteado,
      citopatologico_solicitado.filtro_procedimento as filtro_procedimento_solicitado,
      citopatologico_avaliado.filtro_procedimento as filtro_procedimento_avaliado
    FROM patients pt
      LEFT JOIN citopatologico_coletado ON citopatologico_coletado.id_paciente = pt.id_paciente
      LEFT JOIN citopatologico_solicitado ON citopatologico_solicitado.id_paciente = pt.id_paciente
      LEFT JOIN citopatologico_avaliado ON citopatologico_avaliado.id_paciente = pt.id_paciente
    WHERE pt.city_hall_id = 2303709
      AND pt.dt_nascimento > CURRENT_DATE - INTERVAL '65 years' -- filtra idade relacionada ao exame
      AND pt.dt_nascimento <=  CURRENT_DATE - INTERVAL '25 years'
      AND pt.sexo = 'F' -- busca apenas sexo feminino
) ex
    WHERE ex.id_paciente = 12345 AND ex.dt_avaliado IS NOT null
  )
  SELECT
    sc.id_agendamento as id,
    sc.id_paciente as "patientPecId",
    (sc.dt_criacao + sc.hr_criacao::time)::timestamp as "createdAt",
    (sc.data_agenda + sc.hr_agendado::time)::timestamp as "agendaAt"
  FROM appointments sc
  INNER JOIN exams ex on ex.id_paciente = sc.id_paciente
  WHERE ex.dt_coleta = sc.dt_criacao
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological acs#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.id_profissional IS NOT null AND p.id_profissional IN (101)
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological acs#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.id_profissional IS NOT null AND p.id_profissional IN (101,202)
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological acs#2 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.id_profissional IS null
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological acs#3 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.id_profissional IS NOT null AND p.id_profissional IN (101)
      
       OR p.id_profissional IS null
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological all 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
    WHERE p.id_paciente in (1)
    
     AND lower(p.no_cidadao) ILIKE lower('%Maria%')
    
       AND (p.id_profissional IS NOT null AND p.id_profissional IN (101)
      )
       AND (p.nu_cnes IS NOT null AND p.nu_cnes IN ('2526565')
      ) AND p.dt_nascimento BETWEEN '2010-01-01' AND '2010-01-01'),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc
        WHERE vc.dt_aplicacao BETWEEN '2010-01-01' AND '2010-01-01'
      ),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
    filteredPatients AS (SELECT * FROM fullyVaccinated)
    
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  WHERE sub.vaccinated = true
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological base 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological beginAgeDate#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes WHERE p.dt_nascimento >= '2010-01-01'),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological beginAgeDate#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes WHERE p.dt_nascimento >= '2010-01-01T03:00:00.000Z'),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological beginVaccinationDate#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc
        WHERE vc.dt_aplicacao >= '2010-01-01'
      ),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological beginVaccinationDate#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc
        WHERE vc.dt_aplicacao >= '2010-01-01T03:00:00.000Z'
      ),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological endAgeDate#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes WHERE p.dt_nascimento <= '2010-01-01'),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological endAgeDate#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes WHERE p.dt_nascimento <= '2010-01-01T03:00:00.000Z'),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological endVaccinationDate#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc
        WHERE vc.dt_aplicacao <= '2010-01-01'
      ),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological endVaccinationDate#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc
        WHERE vc.dt_aplicacao <= '2010-01-01T03:00:00.000Z'
      ),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni acs#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.id_profissional IS NOT null AND p.id_profissional IN (101)
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni acs#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.id_profissional IS NOT null AND p.id_profissional IN (101,202)
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni acs#2 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.id_profissional IS null
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni acs#3 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.id_profissional IS NOT null AND p.id_profissional IN (101)
      
       OR p.id_profissional IS null
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni all 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
    WHERE p.id_paciente in (1)
    
     AND lower(p.no_cidadao) ILIKE lower('%Maria%')
    
       AND (p.id_profissional IS NOT null AND p.id_profissional IN (101)
      )
       AND (p.nu_cnes IS NOT null AND p.nu_cnes IN ('2526565')
      ) AND p.dt_nascimento BETWEEN '2010-01-01' AND '2010-01-01'),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc
        WHERE vc.dt_aplicacao BETWEEN '2010-01-01' AND '2010-01-01'
      ),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
    filteredPatients AS (SELECT * FROM fullyVaccinated)
    
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  WHERE sub.vaccinated = true
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni base 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni beginAgeDate#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes WHERE p.dt_nascimento >= '2010-01-01'),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni beginAgeDate#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes WHERE p.dt_nascimento >= '2010-01-01T03:00:00.000Z'),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni beginVaccinationDate#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc
        WHERE vc.dt_aplicacao >= '2010-01-01'
      ),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni beginVaccinationDate#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc
        WHERE vc.dt_aplicacao >= '2010-01-01T03:00:00.000Z'
      ),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni endAgeDate#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes WHERE p.dt_nascimento <= '2010-01-01'),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni endAgeDate#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes WHERE p.dt_nascimento <= '2010-01-01T03:00:00.000Z'),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni endVaccinationDate#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc
        WHERE vc.dt_aplicacao <= '2010-01-01'
      ),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni endVaccinationDate#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc
        WHERE vc.dt_aplicacao <= '2010-01-01T03:00:00.000Z'
      ),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni patientName#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
     WHERE lower(p.no_cidadao) ILIKE lower('%Maria%')
    ),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni patientName#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
     WHERE lower(p.no_cidadao) ILIKE lower('%José da Silva%')
    ),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni patientName#2 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
     WHERE lower(p.no_cidadao) ILIKE lower('%ÂNGELA%')
    ),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni patientsIds#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
    WHERE p.id_paciente in (1)
    ),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni patientsIds#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
    WHERE p.id_paciente in (1,2,3)
    ),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni units#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.nu_cnes IS NOT null AND p.nu_cnes IN ('2526565')
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni units#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.nu_cnes IS NOT null AND p.nu_cnes IN ('2526565','2481286')
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni units#2 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.nu_cnes IS null
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni units#3 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.nu_cnes IS NOT null AND p.nu_cnes IN ('2526565')
      
       OR p.nu_cnes IS null
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni vaccinated#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
    filteredPatients AS (SELECT * FROM fullyVaccinated)
    
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  WHERE sub.vaccinated = true
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological hasPni vaccinated#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate AND p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  WHERE sub.vaccinated = false
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological patientName#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
     WHERE lower(p.no_cidadao) ILIKE lower('%Maria%')
    ),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological patientName#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
     WHERE lower(p.no_cidadao) ILIKE lower('%José da Silva%')
    ),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological patientName#2 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
     WHERE lower(p.no_cidadao) ILIKE lower('%ÂNGELA%')
    ),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological patientsIds#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
    WHERE p.id_paciente in (1)
    ),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological patientsIds#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
    WHERE p.id_paciente in (1,2,3)
    ),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological units#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.nu_cnes IS NOT null AND p.nu_cnes IN ('2526565')
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological units#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.nu_cnes IS NOT null AND p.nu_cnes IN ('2526565','2481286')
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological units#2 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.nu_cnes IS null
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological units#3 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.nu_cnes IS NOT null AND p.nu_cnes IN ('2526565')
      
       OR p.nu_cnes IS null
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological vaccinated#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
    filteredPatients AS (SELECT * FROM fullyVaccinated)
    
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  WHERE sub.vaccinated = true
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiological vaccinated#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  WHERE sub.vaccinated = false
  ORDER BY name
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport acs#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.id_profissional IS NOT null AND p.id_profissional IN (101)
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport acs#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.id_profissional IS NOT null AND p.id_profissional IN (101,202)
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport acs#2 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.id_profissional IS null
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport acs#3 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.id_profissional IS NOT null AND p.id_profissional IN (101)
      
       OR p.id_profissional IS null
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport all 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
    WHERE p.id_paciente in (1)
    
     AND lower(p.no_cidadao) ILIKE lower('%Maria%')
    
       AND (p.id_profissional IS NOT null AND p.id_profissional IN (101)
      )
       AND (p.nu_cnes IS NOT null AND p.nu_cnes IN ('2526565')
      ) AND p.dt_nascimento BETWEEN '2010-01-01' AND '2010-01-01'),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc
        WHERE vc.dt_aplicacao BETWEEN '2010-01-01' AND '2010-01-01'
      ),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
    filteredPatients AS (SELECT * FROM fullyVaccinated),
    
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  WHERE fn.vaccinated = true
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport base 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport beginAgeDate#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes WHERE p.dt_nascimento >= '2010-01-01'),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport beginAgeDate#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes WHERE p.dt_nascimento >= '2010-01-01T03:00:00.000Z'),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport beginVaccinationDate#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc
        WHERE vc.dt_aplicacao >= '2010-01-01'
      ),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport beginVaccinationDate#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc
        WHERE vc.dt_aplicacao >= '2010-01-01T03:00:00.000Z'
      ),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport endAgeDate#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes WHERE p.dt_nascimento <= '2010-01-01'),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport endAgeDate#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes WHERE p.dt_nascimento <= '2010-01-01T03:00:00.000Z'),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport endVaccinationDate#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc
        WHERE vc.dt_aplicacao <= '2010-01-01'
      ),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport endVaccinationDate#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc
        WHERE vc.dt_aplicacao <= '2010-01-01T03:00:00.000Z'
      ),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni acs#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.id_profissional IS NOT null AND p.id_profissional IN (101)
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni acs#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.id_profissional IS NOT null AND p.id_profissional IN (101,202)
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni acs#2 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.id_profissional IS null
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni acs#3 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.id_profissional IS NOT null AND p.id_profissional IN (101)
      
       OR p.id_profissional IS null
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni all 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
    WHERE p.id_paciente in (1)
    
     AND lower(p.no_cidadao) ILIKE lower('%Maria%')
    
       AND (p.id_profissional IS NOT null AND p.id_profissional IN (101)
      )
       AND (p.nu_cnes IS NOT null AND p.nu_cnes IN ('2526565')
      ) AND p.dt_nascimento BETWEEN '2010-01-01' AND '2010-01-01'),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc
        WHERE vc.dt_aplicacao BETWEEN '2010-01-01' AND '2010-01-01'
      ),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
    filteredPatients AS (SELECT * FROM fullyVaccinated),
    
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  WHERE fn.vaccinated = true
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni base 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni beginAgeDate#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes WHERE p.dt_nascimento >= '2010-01-01'),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni beginAgeDate#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes WHERE p.dt_nascimento >= '2010-01-01T03:00:00.000Z'),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni beginVaccinationDate#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc
        WHERE vc.dt_aplicacao >= '2010-01-01'
      ),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni beginVaccinationDate#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc
        WHERE vc.dt_aplicacao >= '2010-01-01T03:00:00.000Z'
      ),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni endAgeDate#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes WHERE p.dt_nascimento <= '2010-01-01'),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni endAgeDate#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes WHERE p.dt_nascimento <= '2010-01-01T03:00:00.000Z'),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni endVaccinationDate#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc
        WHERE vc.dt_aplicacao <= '2010-01-01'
      ),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni endVaccinationDate#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc
        WHERE vc.dt_aplicacao <= '2010-01-01T03:00:00.000Z'
      ),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni patientName#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
     WHERE lower(p.no_cidadao) ILIKE lower('%Maria%')
    ),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni patientName#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
     WHERE lower(p.no_cidadao) ILIKE lower('%José da Silva%')
    ),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni patientName#2 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
     WHERE lower(p.no_cidadao) ILIKE lower('%ÂNGELA%')
    ),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni patientsIds#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
    WHERE p.id_paciente in (1)
    ),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni patientsIds#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
    WHERE p.id_paciente in (1,2,3)
    ),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni units#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.nu_cnes IS NOT null AND p.nu_cnes IN ('2526565')
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni units#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.nu_cnes IS NOT null AND p.nu_cnes IN ('2526565','2481286')
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni units#2 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.nu_cnes IS null
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni units#3 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.nu_cnes IS NOT null AND p.nu_cnes IN ('2526565')
      
       OR p.nu_cnes IS null
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni vaccinated#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
    filteredPatients AS (SELECT * FROM fullyVaccinated),
    
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  WHERE fn.vaccinated = true
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport hasPni vaccinated#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    input_data(name, birthdate, applicationDate) AS (
      SELECT name, birthdate, applicationDate
      FROM ROWS FROM (
        unnest($1::varchar[]),
        unnest($2::date[]),
        unnest($3::date[])
      ) AS t(name, birthdate, applicationDate)
    ),
    patientsUpdated AS (SELECT
      p.id_paciente as "patientPecId",
      p.no_cidadao as name,
      p.cpf as document,
      p.dt_nascimento as birthdate,
      p.cns,
      CASE
        WHEN p.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      p.logradouro as address,
      p.bairro as neighborhood,
      p.contato as phone,
      null::text as email,
      p.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      'Vacina HPV quadrivalente'::text as immunobiological,
      null::text as dose,
      i.applicationDate as "applicationDate",
      p.acs,
      p.unit,
      true as "updatedWithPni"
    FROM patients p
      JOIN input_data i ON lower(p.no_cidadao::varchar) = i.name AND DATE(p.dt_nascimento) = i.birthdate
      WHERE p.id_paciente NOT IN (SELECT pw."patientPecId" FROM fromVaccination pw)
    ),
    fullyVaccinated AS (
      SELECT * FROM fromVaccination
      union all
      SELECT * FROM patientsUpdated
    )
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  WHERE fn.vaccinated = false
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport patientName#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
     WHERE lower(p.no_cidadao) ILIKE lower('%Maria%')
    ),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport patientName#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
     WHERE lower(p.no_cidadao) ILIKE lower('%José da Silva%')
    ),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport patientName#2 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
     WHERE lower(p.no_cidadao) ILIKE lower('%ÂNGELA%')
    ),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport patientsIds#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
    WHERE p.id_paciente in (1)
    ),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport patientsIds#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
    WHERE p.id_paciente in (1,2,3)
    ),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport units#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.nu_cnes IS NOT null AND p.nu_cnes IN ('2526565')
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport units#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.nu_cnes IS NOT null AND p.nu_cnes IN ('2526565','2481286')
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport units#2 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.nu_cnes IS null
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport units#3 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.nu_cnes IS NOT null AND p.nu_cnes IN ('2526565')
      
       OR p.nu_cnes IS null
      )),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport vaccinated#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
    filteredPatients AS (SELECT * FROM fullyVaccinated),
    
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  WHERE fn.vaccinated = true
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryAllPatientsByImmunobiologicalForExport vaccinated#1 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
    LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes),
  vaccinations AS (SELECT * FROM (
SELECT
    tb_fat_vacinacao.co_seq_fat_vacinacao as vaccination_id,
    tb_fat_vacinacao_vacina.co_seq_fat_vacinacao_vacina as id,
    tb_fat_vacinacao.co_fat_cidadao_pec AS id_paciente, --ID do paciente precente na query pacientes
    tb_fat_vacinacao_vacina.co_dim_imunobiologico AS co_seq_imuno, --codigo sequencia criado pelo banco
    tb_dim_imunobiologico.nu_identificador::int AS id_imuno, -- numero utilizado pelo ministério da saúde
    tb_dim_imunobiologico.no_imunobiologico, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico id_dose,
    tb_dim_dose_imunobiologico.nu_identificador AS nu_dose_ms,
    tb_dim_dose_imunobiologico.sg_dose_imunobiologico AS dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_dim_dose_imunobiologico.no_dose_imunobiologico AS no_dose, --adcionei apenas para validar mas como tem relacionamento pode remnover se necessário for
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_equipe, --equipe responsável pela aplicação
    tb_fat_vacinacao_vacina.co_dim_equipe AS id_profissional, -- id do profissional responsavel pela aplicação
    tb_fat_vacinacao_vacina.co_dim_cbo as id_cbo, --id do cbo do profissional
    TO_DATE(tb_fat_vacinacao_vacina.co_dim_tempo::text, 'YYYYMMDD') AS dt_aplicacao, -- data da aplicação
    -- tb_fat_vacinacao_vacina.no_fabricante AS fabricante, --Fabricante informado pelo responsavel da aplicação da dose
    tb_fat_vacinacao_vacina.no_lote AS lote, --lote informado pelo responsavel da aplicação da dose
    tb_dim_unidade_saude.nu_cnes,
    tb_fat_vacinacao.co_dim_unidade_saude
FROM tb_fat_vacinacao
    LEFT JOIN tb_fat_vacinacao_vacina ON tb_fat_vacinacao.co_seq_fat_vacinacao = tb_fat_vacinacao_vacina.co_fat_vacinacao
    LEFT JOIN tb_dim_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_imunobiologico = tb_dim_imunobiologico.co_seq_dim_imunobiologico
    LEFT JOIN tb_dim_dose_imunobiologico ON tb_fat_vacinacao_vacina.co_dim_dose_imunobiologico = tb_dim_dose_imunobiologico.co_seq_dim_dose_imunobiologico
    LEFT JOIN tb_dim_unidade_saude ON tb_fat_vacinacao.co_dim_unidade_saude = tb_dim_unidade_saude.co_seq_dim_unidade_saude
where
	tb_fat_vacinacao.co_fat_cidadao_pec is not null
	--AND tb_dim_imunobiologico.nu_identificador in ('60', '67', '68', '93') --caso queira buscar apenas as vacinas relacionadas a HPV desconetar
) vc),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao, vc.no_imunobiologico, vc.no_dose FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.no_imunobiologico as immunobiological,
      pw.no_dose as dose,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit,
      false as "updatedWithPni"
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::text as immunobiological,
        null::text as dose,
        null::date as "applicationDate",
        pt.acs,
        pt.unit,
        false as "updatedWithPni"
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      ),
      
  non_nulls AS (
    SELECT DISTINCT ON (name, birthdate, immunobiological) *
    FROM filteredPatients
    WHERE immunobiological IS NOT NULL
  ),
  nulls AS (
    SELECT DISTINCT ON (name, birthdate) *
    FROM filteredPatients t
    WHERE immunobiological IS NULL
      AND NOT EXISTS (
        SELECT 1 FROM filteredPatients
        WHERE name = t.name
          AND birthdate = t.birthdate
          AND immunobiological IS NOT NULL
      )
  ),
  finalResult as (
    SELECT * FROM non_nulls
    UNION ALL
    SELECT * FROM nulls
  )
  SELECT * FROM finalResult fn
  WHERE fn.vaccinated = false
  ORDER BY name;
  "
`;

exports[`SQL generated for valid filters patient/direct queryPatientsById many 1`] = `
"
  SELECT
    p.id_paciente as "patientPecId",
    p.no_cidadao as name,
    p.cpf as document,
    p.dt_nascimento as birthdate,
    p.cns,
    CASE
      WHEN p.sexo = 'F' THEN 'Feminino'
      ELSE 'Masculino'
    END AS gender,
    p.logradouro as address,
    p.bairro as neighborhood,
    p.contato as phone,
    null::text as email,
    p.no_mae as "responsibleName",
    null::text as "responsibleDocument",
    CASE
      WHEN p.id_profissional IS NOT NULL THEN json_build_object(
        'id', p.id_profissional::int,
        'name', p.no_prof_cad
      )
      ELSE NULL
    END AS acs,
    CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
  FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
  LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  WHERE p.id_paciente IN (1,2,3)
"
`;

exports[`SQL generated for valid filters patient/direct queryPatientsById one 1`] = `
"
  SELECT
    p.id_paciente as "patientPecId",
    p.no_cidadao as name,
    p.cpf as document,
    p.dt_nascimento as birthdate,
    p.cns,
    CASE
      WHEN p.sexo = 'F' THEN 'Feminino'
      ELSE 'Masculino'
    END AS gender,
    p.logradouro as address,
    p.bairro as neighborhood,
    p.contato as phone,
    null::text as email,
    p.no_mae as "responsibleName",
    null::text as "responsibleDocument",
    CASE
      WHEN p.id_profissional IS NOT NULL THEN json_build_object(
        'id', p.id_profissional::int,
        'name', p.no_prof_cad
      )
      ELSE NULL
    END AS acs,
    CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
  FROM (
SELECT
    DISTINCT ON (tb_fat_cidadao_pec.co_seq_fat_cidadao_pec)
    tb_fat_cidadao_pec.co_seq_fat_cidadao_pec AS id_paciente, --ID do paciente onde sempre estará relacionadadas nas tabelas de atendimentos
    tb_cidadao.co_seq_cidadao AS co_cidadao, -- ID do cidadao na tabela cidadao não usamos para relacionamento com atendimentos
    tb_cidadao.no_cidadao,
    tb_cidadao.dt_nascimento,
    CASE
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 year' THEN
            concat(
                extract(year from age(public.tb_cidadao.dt_nascimento))::int,
                'a ',
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        WHEN age(public.tb_cidadao.dt_nascimento) >= interval '1 month' THEN
            concat(
                extract(month from age(public.tb_cidadao.dt_nascimento))::int,
                'm ',
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
        ELSE
            concat(
                extract(day from age(public.tb_cidadao.dt_nascimento))::int,
                'd'
            )
    END AS idade,
    SUBSTRING(public.tb_cidadao.no_sexo FROM 1 FOR 1) AS sexo,
    tb_cidadao.nu_cns AS cns,
    tb_cidadao.nu_cpf AS cpf,
    UPPER(tb_cidadao.no_mae) as no_mae,
    COALESCE(tb_acomp_cidadaos_vinculados.st_possui_fci, 2) AS status_cadastro, -- aqui é a informação se o cidadão possui ficha de cadastro individual: INCOSSISTÊNCIA = 0, ATIVO = 1, MUDANÇA DE TERRITÓRIO / SEM EQUIPE = 2,
    CASE
	    WHEN tb_cidadao.co_unico_ultima_ficha IS NOT NULL THEN 1
	    ELSE 0
	END AS fci, --informa se possue ficha de cadastro individual caso seja = 0 só possui o cadastro rápido sem vinculo com ACS
    UPPER(tb_acomp_cidadaos_vinculados.no_responsavel) AS resp_familiar,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_logradouro_domicilio, tb_cidadao.ds_logradouro)) AS logradouro,
    COALESCE(tb_acomp_cidadaos_vinculados.nu_numero_domicilio, tb_cidadao.nu_numero) AS nu_logradouro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.no_bairro_domicilio, tb_cidadao.no_bairro)) AS bairro,
    UPPER(COALESCE(tb_acomp_cidadaos_vinculados.ds_cep_domicilio, tb_cidadao.ds_cep)) AS cep,
    COALESCE(tb_cidadao.nu_telefone_celular, tb_cidadao.nu_telefone_residencial, tb_cidadao.nu_telefone_contato) as contato, -- busca um dos três
    COALESCE(tb_cds_cad_individual.nu_micro_area, 'FA') as nu_micro_area,
    tb_dim_profissional.co_seq_dim_profissional AS id_profissional, --ID do profissional do cadastras, esse é o mesmo do relacionamento dos atendimentos
    UPPER(tb_dim_profissional.no_profissional) AS no_prof_cad, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de profissionais
    CASE
	    WHEN tb_cds_prof.nu_cbo_2002 ILIKE ANY (ARRAY['515105', '322255']) THEN 1
	    ELSE 0
	END AS cbo_acs, -- Validacao pra saber se o cadastros foi realizado por ACS
	tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
	tb_dim_equipe.co_seq_dim_equipe as id_equipe, --caso esteja null é porque o ACS informou mudança de territorio (ativou no cadastro mudou-se)
    tb_dim_equipe.no_equipe, --Deixei a coluna apenas pra validação da informação mas acima a id do profissional que terá relacionamento com a tabela de equipes
    case -- Aqui está a busca de cadastros duplicados
    WHEN EXISTS (
        SELECT 1
        FROM tb_cidadao duplicado
        WHERE
            duplicado.no_cidadao = tb_cidadao.no_cidadao
            AND duplicado.dt_nascimento = tb_cidadao.dt_nascimento
            -- AND duplicado.no_mae = tb_cidadao.no_mae -- caso queira deixar a busca mais refinada ativar
            AND duplicado.st_ativo_para_exibicao = 1
            AND duplicado.co_seq_cidadao <> tb_cidadao.co_seq_cidadao -- Garante que é outro registro
    )
    THEN 1
    ELSE 0
	END AS duplicado,
	tb_cidadao.st_unificado, -- Aqui informo quais cadastros já pussuem unificação
	tb_dim_unidade_saude.nu_cnes
FROM public.tb_cidadao
	LEFT JOIN tb_fat_cidadao_pec
		ON tb_cidadao.co_seq_cidadao = tb_fat_cidadao_pec.co_cidadao
	LEFT JOIN tb_acomp_cidadaos_vinculados
		ON tb_cidadao.co_seq_cidadao = tb_acomp_cidadaos_vinculados.co_cidadao
	LEFT JOIN tb_cds_cad_individual
    	ON tb_cidadao.co_unico_ultima_ficha = tb_cds_cad_individual.co_unico_ficha
    LEFT JOIN tb_cds_prof
    	ON tb_cds_cad_individual.co_cds_prof_cadastrante = tb_cds_prof.co_seq_cds_prof
    LEFT JOIN tb_dim_profissional
    	ON tb_cds_prof.nu_cns = tb_dim_profissional.nu_cns
    LEFT JOIN tb_dim_equipe
   		 ON tb_acomp_cidadaos_vinculados.nu_ine_vinc_equipe = tb_dim_equipe.nu_ine
    LEFT JOIN tb_dim_unidade_saude
   		 ON tb_acomp_cidadaos_vinculados.nu_cnes_vinc_equipe = tb_dim_unidade_saude.nu_cnes
where
	 tb_cidadao.st_ativo = 1
	 AND tb_cidadao.st_faleceu = 0
	 AND tb_cidadao.st_ativo_para_exibicao = 1
) p
  LEFT JOIN (
SELECT
    tb_dim_equipe.co_seq_dim_equipe as id_equipe,
    tb_dim_municipio.co_seq_dim_municipio as id_municipio, --esse id servirá para definir o municipio no acesso do cliente ao sistema
  	tb_localidade.co_ibge,
    tb_localidade.no_localidade || ' - ' || tb_uf.sg_uf as municipio,
    tb_dim_unidade_saude.co_seq_dim_unidade_saude as id_ubs,
    tb_unidade_saude.nu_cnes,
    UPPER(tb_unidade_saude.no_unidade_saude) as no_unidade,
    tb_equipe.nu_ine, --número da equipe
    tb_equipe.no_equipe,
    tb_tipo_equipe.sg_tipo_equipe as tipo_equipe, -- tipo de equipe cadastrada
    tb_tipo_equipe.nu_ms, -- identificador do ministério da saúde para equipe (portarias)
    tb_tipo_equipe.no_tipo_equipe,
    tb_unidade_saude.nu_telefone_comercial as contato,
    tb_unidade_saude.ds_logradouro as Logradouro,
    tb_unidade_saude.nu_numero as nu_logradouro,
    tb_unidade_saude.no_bairro as bairro,
    tb_unidade_saude.ds_cep as cep
FROM tb_unidade_saude
	LEFT JOIN tb_localidade ON tb_localidade.co_localidade = tb_unidade_saude.co_localidade_endereco
	LEFT JOIN tb_uf ON tb_uf.co_uf = tb_localidade.co_uf
	LEFT JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
	LEFT JOIN tb_tipo_equipe ON tb_equipe.tp_equipe = tb_tipo_equipe.co_seq_tipo_equipe
	LEFT JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
	LEFT JOIN tb_dim_unidade_saude ON tb_unidade_saude.nu_cnes = tb_dim_unidade_saude.nu_cnes
	LEFT JOIN tb_dim_municipio on tb_localidade.co_ibge = tb_dim_municipio.co_ibge
WHERE
	tb_tipo_equipe.nu_ms IN ('70', '76') -- Tipo equipe eSF e eAP, essas são as equipes reponsáveis por vinculação dos  Agente comunitário de saúde / Técnico em agente comunitário de saúde
  AND tb_equipe.st_ativo = 1 -- Busca apenas as equipes ativas
  AND tb_dim_equipe.co_seq_dim_equipe IS NOT null
) un ON un.nu_cnes = p.nu_cnes
  WHERE p.id_paciente IN (1)
"
`;

exports[`SQL generated for valid filters patient/index queryAllPatientsByImmunobiological acs#0 1`] = `
"
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (SELECT * FROM patients WHERE city_hall_id = 2303709) p
    LEFT JOIN (SELECT * FROM unit WHERE city_hall_id = 2303709) un ON un.nu_cnes = p.nu_cnes
       WHERE (p.id_profissional IS NOT null AND p.id_profissional IN (101)
      )),
  vaccinations AS (SELECT * FROM vaccination vc
    WHERE vc.city_hall_id = 2303709),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  "
`;

