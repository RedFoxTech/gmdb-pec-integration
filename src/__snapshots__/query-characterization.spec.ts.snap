			FROM (
SELECT DISTINCT on (tb_dim_profissional.co_seq_dim_profissional)
	tb_dim_equipe.co_seq_dim_equipe as id_equipe,
	tb_dim_profissional.co_seq_dim_profissional AS id_profissional,
	UPPER(tb_dim_profissional.no_profissional) AS no_profissional,
	tb_dim_profissional.nu_cns AS cns,
	tb_cds_prof.nu_cbo_2002,
	tb_lotacao.dt_desativacao_lotacao, --aqui é a data quando o profissional foi desligado da equipe
	tb_unidade_saude.no_unidade_saude,
	COALESCE(tb_dim_profissional.st_registro_valido, 0) AS ativo,
	tb_unidade_saude.nu_cnes
FROM tb_dim_profissional
INNER JOIN tb_cds_prof ON tb_dim_profissional.nu_cns = tb_cds_prof.nu_cns
INNER JOIN tb_prof ON tb_dim_profissional.nu_cns = tb_prof.nu_cns
INNER JOIN tb_lotacao ON tb_prof.co_seq_prof = tb_lotacao.co_prof
INNER JOIN tb_unidade_saude ON  tb_lotacao.co_unidade_saude = tb_unidade_saude.co_seq_unidade_saude
INNER JOIN tb_equipe ON tb_unidade_saude.co_seq_unidade_saude = tb_equipe.co_unidade_saude
INNER JOIN tb_dim_equipe ON tb_equipe.nu_ine = tb_dim_equipe.nu_ine
WHERE
tb_cds_prof.nu_cbo_2002 in ('515105', '322255') AND tb_lotacao.dt_desativacao_lotacao IS NULL
) pr
			LEFT JOIN (
    WITH patients AS (SELECT
      p.*,
      CASE
        WHEN p.id_profissional IS NOT NULL THEN json_build_object(
          'id', p.id_profissional::int,
          'name', p.no_prof_cad
        )
        ELSE NULL
      END AS acs,
      CASE
        WHEN un.nu_cnes IS NOT NULL THEN json_build_object(
          'id', un.nu_cnes,
          'name', un.no_unidade,
          'address', un.logradouro,
          'addressNumber', un.nu_logradouro,
          'neighborhood', un.bairro,
          'zipcode', un.cep
        )
        ELSE NULL
      END AS unit
    FROM (SELECT * FROM patients WHERE city_hall_id = 2303709) p
    LEFT JOIN (SELECT * FROM unit WHERE city_hall_id = 2303709) un ON un.nu_cnes = p.nu_cnes WHERE p.dt_nascimento BETWEEN '2010-01-01' AND '2010-01-01'),
  vaccinations AS (SELECT * FROM vaccination vc
    WHERE vc.city_hall_id = 2303709),
    patientsWithVaccinations AS (SELECT pt.*, vc.id_imuno, vc.dt_aplicacao  FROM patients pt
    LEFT JOIN vaccinations vc ON vc.id_paciente = pt.id_paciente
    WHERE vc.id_paciente IS NOT null),
    fromVaccination as (
    SELECT
      DISTINCT ON (pw.id_paciente)
      pw.id_paciente as "patientPecId",
      pw.no_cidadao as name,
      pw.cpf as document,
      pw.dt_nascimento as birthdate,
      pw.cns,
      CASE
        WHEN pw.sexo = 'F' THEN 'Feminino'
        ELSE 'Masculino'
      END AS gender,
      pw.logradouro as address,
      pw.bairro as neighborhood,
      pw.contato as phone,
      null::text as email,
      pw.no_mae as "responsibleName",
      null::text as "responsibleDocument",
      true as vaccinated,
      pw.dt_aplicacao as "applicationDate",
      pw.acs,
      pw.unit
    FROM patientsWithVaccinations pw
    WHERE pw.id_imuno IN (60,67,68,93))
  ,
    fullyVaccinated AS (SELECT * FROM fromVaccination)
    ,
      notVaccinated AS (SELECT
        pt.id_paciente as "patientPecId",
        pt.no_cidadao as name,
        pt.cpf as document,
        pt.dt_nascimento as birthdate,
        pt.cns,
        CASE
          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  ) pt on (pt.acs->>'id')::int = pr.id_profissional::int
			WHERE pr.ativo > 0 AND pr.nu_cnes in ('2526565')
			GROUP BY pr.id_profissional, pr.no_profissional, pr.cns, pr.nu_cnes
		),
		rankedAcs as (
			SELECT
				av.*,
				DENSE_RANK() OVER (ORDER BY av.vaccinated DESC)::int AS position
			FROM acsWithVaccination av
		)
		SELECT * FROM rankedAcs ra
	
		WHERE ra.id in (101)
		
		 AND (
			position IN (
				(SELECT position FROM rankedAcs ORDER BY position ASC LIMIT 2)
			)
			OR position = 1
			OR position IN (
				SELECT position
				FROM rankedAcs
				ORDER BY position DESC
				LIMIT 2
			)
		)
		
		ORDER BY ra.vaccinated DESC
	"
`;

