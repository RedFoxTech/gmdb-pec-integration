          WHEN pt.sexo = 'F' THEN 'Feminino'
          ELSE 'Masculino'
        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  ) pt on (pt.unit->>'id') = un.nu_cnes
      GROUP BY un.nu_cnes, un.no_unidade, un.logradouro, un.nu_logradouro, un.bairro, un.cep
    ),
    rankedUnits as (
      SELECT
        uv.*,
        DENSE_RANK() OVER (ORDER BY uv.vaccinated DESC)::int AS position
      FROM unitsWithVaccination uv
    )
    SELECT * FROM rankedUnits ru
  
    WHERE ru.id in ('2526565','2481286')
    
    ORDER BY ru.vaccinated DESC
  "
`;

