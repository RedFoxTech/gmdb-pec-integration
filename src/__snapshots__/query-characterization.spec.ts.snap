        END AS gender,
        pt.logradouro as address,
        pt.bairro as neighborhood,
        pt.contato as phone,
        null::text as email,
        pt.no_mae as "responsibleName",
        null::text as "responsibleDocument",
        false as vaccinated,
        null::date as "applicationDate",
        pt.acs,
        pt.unit
      FROM patients pt WHERE pt.id_paciente NOT IN (SELECT pw."patientPecId" FROM fullyVaccinated pw)),
    
      filteredPatients AS (
        select * from fullyVaccinated
        union all
        select * from notVaccinated
      )
      
  SELECT * FROM (
    SELECT DISTINCT ON (fp.name, fp.birthdate) * FROM filteredPatients fp
    ORDER BY name, birthdate, vaccinated DESC
  ) sub
  
  ORDER BY name
  ) pt on (pt.acs->>'id')::int = pr.id_profissional::int
			WHERE pr.city_hall_id = 2303709 AND pr.ativo > 0 AND pr.id_unit in ('2526565','2481286')
			GROUP BY pr.id_profissional, pr.no_profissional, pr.cns, pr.id_unit
		),
		rankedAcs as (
			SELECT
				av.*,
				DENSE_RANK() OVER (ORDER BY av.vaccinated DESC)::int AS position
			FROM acsWithVaccination av
		)
		SELECT * FROM rankedAcs ra
	
		ORDER BY ra.vaccinated DESC
	"
`;

exports[`SQL generated for valid filters acs/index queryAllAcs many 1`] = `
"
		SELECT
			id_profissional AS id,
			no_profissional as name,
			cns,
			id_unit as "unitId"
		FROM professional pf
		WHERE pf.city_hall_id = 2303709 AND pf.ativo > 0
	
			AND pf.id_unit in ('2526565','2481286')
		"
`;

