    WITH citopatologico_coletado AS (
      SELECT * FROM collected
      WHERE city_hall_id = 2303709
      GROUP BY
        id_atend_coleta, import_version_id, city_hall_id
      
      HAVING
          dt_coleta BETWEEN '2010-01-01'::DATE - INTERVAL '3 years' AND '2010-01-01'::DATE
      
    ),
    citopatologico_solicitado AS (
      SELECT * FROM requested
      WHERE city_hall_id = 2303709
      GROUP BY
        id_atend_solicitacao, import_version_id, city_hall_id
        
        HAVING
            dt_solicitado BETWEEN '2010-01-01'::DATE - INTERVAL '3 years' AND '2010-01-01'::DATE
        
