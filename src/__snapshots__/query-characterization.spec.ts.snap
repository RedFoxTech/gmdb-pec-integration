          WHEN GREATEST(ap.dt_solicitado, ap.dt_coleta, ap.dt_avaliado) >= CURRENT_DATE - INTERVAL '1 year' THEN 2  -- Em dia
          WHEN GREATEST(ap.dt_solicitado, ap.dt_coleta, ap.dt_avaliado) >= CURRENT_DATE - INTERVAL '3 years' THEN 1 -- Atenção
